.page { padding: 28rpx 30rpx 60rpx; }
.topline { display: flex; align-items: center; justify-content: space-between; }
.job-pill { max-width: 470rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 12rpx 20rpx; border-radius: 100rpx; background: #e9edff; color: #3e53c1; font-size: 23rpx; }
.progress { color: #68758c; font-size: 23rpx; }
.progress-track { height: 10rpx; background: #e2e7f4; border-radius: 10rpx; margin-top: 20rpx; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 10rpx; background: #687af1; transition: width .25s; }
.scene { height: 330rpx; margin-top: 28rpx; border-radius: 26rpx; background: radial-gradient(circle at 50% 18%, #dfe6ff, #f4f6fb 65%); display: flex; align-items: center; justify-content: center; flex-direction: column; overflow: hidden; }
.static-avatar { width: 200rpx; height: 200rpx; border-radius: 50%; background: #596adb; color: white; line-height: 200rpx; text-align: center; font-size: 90rpx; box-shadow: 0 18rpx 44rpx rgba(60,82,183,.25); }
.scene-caption { font-size: 23rpx; color: #657395; margin-top: 8rpx; }
.prompt-card { position: relative; border-radius: 24rpx; padding: 40rpx; background: #fff; margin-top: 20rpx; min-height: 130rpx; box-shadow: 0 10rpx 26rpx rgba(32,48,91,.05); }
.quote-mark { color: #bcc6fa; font-size: 90rpx; line-height: 50rpx; }
.prompt { font-size: 32rpx; font-weight: 600; line-height: 1.55; margin-top: 8rpx; }
.notice { color: #9a650c; background: #fff3d8; padding: 20rpx 24rpx; border-radius: 12rpx; margin-top: 20rpx; font-size: 23rpx; }
.input-card { background: #fff; border-radius: 24rpx; padding: 30rpx; margin-top: 22rpx; }
.input-title { font-size: 26rpx; font-weight: 700; }
.voice-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.voice-button, .play-button { flex: 1; margin: 0; font-size: 25rpx; border-radius: 14rpx; background: #e9edff; color: #394fbf; }
.voice-button.recording { background: #ffe9e9; color: #a53f3f; }
.voice-hint { margin-top: 16rpx; color: #69738a; font-size: 22rpx; line-height: 1.5; }
.answer-box { width: 100%; min-height: 180rpx; margin-top: 24rpx; font-size: 28rpx; line-height: 1.5; }
.input-hint { font-size: 22rpx; color: #8b93a6; margin-top: 16rpx; }
.submit-button { margin-top: 30rpx; min-height: 94rpx; line-height: 94rpx; }
.exit-button { margin-top: 18rpx; background: transparent; color: #7d879e; font-size: 24rpx; }
