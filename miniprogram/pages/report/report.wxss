.page { padding: 30rpx 30rpx 70rpx; }
.report-hero { background: #111a35; color: #fff; border-radius: 28rpx; padding: 48rpx 40rpx; margin-bottom: 24rpx; }
.overline { color: #aebcff; font-size: 23rpx; letter-spacing: 3rpx; }
.title { font-size: 46rpx; font-weight: 700; line-height: 1.35; margin-top: 22rpx; }
.meta { color: #c6cee9; font-size: 23rpx; margin-top: 28rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 34rpx; margin-bottom: 20rpx; }
.section-title { font-size: 29rpx; font-weight: 700; margin-bottom: 26rpx; }
.loading { color: #69748f; font-size: 27rpx; }
.report-text { font-size: 27rpx; line-height: 1.75; white-space: pre-wrap; }
.source-note { font-size: 22rpx; color: #8a92a7; margin-top: 28rpx; }
.history-title { margin: 38rpx 4rpx 20rpx; }
.answer-count { color: #5368e8; font-size: 23rpx; font-weight: 600; }
.question { font-size: 27rpx; font-weight: 600; line-height: 1.5; margin-top: 14rpx; }
.answer { border-left: 5rpx solid #dce2ff; padding-left: 20rpx; margin-top: 22rpx; color: #56617b; font-size: 25rpx; line-height: 1.6; }
.answer-label { margin-top: 26rpx; color: #394fbf; font-size: 24rpx; font-weight: 600; }
.probe { font-size: 24rpx; }
.rewrite-button { margin-top: 28rpx; }
.rewrite-result, .rewrite-editor { border-top: 1rpx solid #e7eaf2; margin-top: 28rpx; padding-top: 8rpx; }
.rewrite-input { width: 100%; min-height: 160rpx; margin: 24rpx 0; font-size: 27rpx; line-height: 1.6; }
.delete-button { margin-top: 18rpx; color: #7b859c; background: transparent; font-size: 24rpx; }
