<view class="page">
  <view class="report-hero">
    <view class="overline">练习已完成</view>
    <view class="title">把这次回答，
      <view>变成下次的底气。</view>
    </view>
    <view class="meta">{{job}} · 约 {{duration}} 分钟</view>
  </view>

  <view class="card">
    <view class="section-title">本次复盘</view>
    <view wx:if="{{loading}}" class="loading">正在整理回答…</view>
    <view wx:else class="report-text">{{report}}</view>
    <view class="source-note">{{aiGenerated ? '以上为 AI 生成的练习建议，请自行核对。' : '以上为固定练习提示，不是 AI 评分。'}}</view>
  </view>

  <view class="section-title history-title">回看你的回答</view>
  <view wx:for="{{answers}}" wx:key="index" class="card answer-card">
    <view class="answer-count">第 {{index + 1}} 轮</view>
    <view class="question">{{item.question}}</view>
    <view class="answer">{{item.answer}}</view>
  </view>

  <button class="primary-button" bindtap="restart">再练一场</button>
  <button class="delete-button" bindtap="clear">删除本机回答</button>
</view>
