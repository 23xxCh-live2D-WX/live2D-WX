.page { padding: 30rpx 30rpx 70rpx; }
.hero { position: relative; overflow: hidden; background: #111a35; color: #fff; border-radius: 30rpx; padding: 52rpx 40rpx 64rpx; margin-bottom: 28rpx; }
.eyebrow { color: #b4c1ff; font-size: 24rpx; letter-spacing: 3rpx; }
.headline { position: relative; z-index: 1; font-size: 48rpx; font-weight: 700; line-height: 1.35; margin-top: 24rpx; }
.hero-note { position: relative; z-index: 1; color: #cbd2ee; font-size: 25rpx; margin-top: 28rpx; }
.hero-orb { position: absolute; right: -45rpx; top: 20rpx; width: 260rpx; height: 260rpx; line-height: 260rpx; border-radius: 50%; text-align: center; font-size: 120rpx; color: #dfe4ff; background: radial-gradient(circle at 30% 30%, #8095ff, #5159a7 65%, #2a3465); opacity: .82; }
.card { background: #fff; border-radius: 26rpx; padding: 34rpx; margin-bottom: 22rpx; box-shadow: 0 12rpx 34rpx rgba(32,48,91,.04); }
.card-title { font-size: 29rpx; font-weight: 700; margin-bottom: 24rpx; }
.job-input { height: 90rpx; background: #f3f5fb; border-radius: 16rpx; padding: 0 24rpx; font-size: 28rpx; }
.hint { font-size: 23rpx; line-height: 1.55; color: #69738a; margin-top: 18rpx; }
.mode-row { display: flex; gap: 18rpx; }
.mode { flex: 1; min-width: 0; border: 2rpx solid #e8ebf4; border-radius: 18rpx; padding: 22rpx; text-align: center; }
.mode.selected { border-color: #6274ed; background: #f1f3ff; }
.mode-icon { font-size: 50rpx; color: #596dda; }
.mode-name { font-size: 24rpx; margin-top: 9rpx; }
.consent-row { display: flex; align-items: center; gap: 18rpx; margin-top: 20rpx; font-size: 23rpx; line-height: 1.45; }
.consent-row text { flex: 1; }
.start-button { margin-top: 32rpx; height: 96rpx; line-height: 96rpx; }
.footnote { text-align: center; color: #8a91a4; font-size: 22rpx; margin-top: 20rpx; }
