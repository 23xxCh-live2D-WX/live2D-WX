.avatar { position: relative; flex: none; overflow: hidden; border-radius: 50%; background: radial-gradient(circle at 50% 33%, #f5f8ff 0%, #dbe4ff 72%, #c8d4ff 100%); box-shadow: inset 0 0 0 2rpx rgba(255,255,255,.8), 0 12rpx 30rpx rgba(69,89,169,.12); }
.fallback { position: absolute; inset: 0; }
.model-canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; z-index: 8; }
.model-canvas--ready { opacity: 1; }
.halo { position: absolute; inset: 7%; border: 3rpx solid rgba(102,124,225,.28); border-radius: 50%; }
.shadow { position: absolute; left: 22%; bottom: 4%; width: 56%; height: 9%; border-radius: 50%; background: rgba(72,82,153,.13); filter: blur(8rpx); }
.hair-back { position: absolute; z-index: 1; left: 27%; top: 15%; width: 46%; height: 66%; border-radius: 46% 46% 36% 36%; background: #3d3c68; }
.coat { position: absolute; z-index: 2; left: 13%; bottom: -11%; width: 74%; height: 43%; border-radius: 48% 48% 0 0; background: #4d5da8; }
.shirt { position: absolute; z-index: 3; left: 39%; bottom: 1%; width: 22%; height: 28%; border-radius: 45% 45% 0 0; background: #fff8f1; }
.neck { position: absolute; z-index: 4; left: 43%; top: 60%; width: 14%; height: 16%; border-radius: 36%; background: #e9ae9f; }
.ear { position: absolute; z-index: 5; top: 42%; width: 8%; height: 15%; border-radius: 50%; background: #f3c4b7; }
.ear-left { left: 26%; } .ear-right { right: 26%; }
.face { position: absolute; z-index: 6; left: 31%; top: 23%; width: 38%; height: 47%; border-radius: 43% 43% 46% 46%; background: linear-gradient(130deg, #ffe2d5, #f4c4b7); box-shadow: inset -7rpx -5rpx 15rpx rgba(191,124,123,.12); animation: breathe 3s ease-in-out infinite; }
.brow { position: absolute; top: 35%; width: 22%; height: 2%; border-radius: 5rpx; background: #755868; }
.brow-left { left: 17%; transform: rotate(-8deg); } .brow-right { right: 17%; transform: rotate(8deg); }
.eye { position: absolute; top: 42%; width: 19%; height: 10%; border-bottom: 5rpx solid #3b3e64; border-radius: 0 0 50% 50%; animation: blink 5s infinite; }
.eye-left { left: 18%; } .eye-right { right: 18%; }
.nose { position: absolute; top: 55%; left: 49%; width: 4%; height: 7%; border-radius: 50%; background: rgba(197,126,119,.26); }
.mouth { position: absolute; top: 69%; left: 43%; width: 14%; height: 3%; border-radius: 0 0 50% 50%; border-bottom: 4rpx solid #b96f77; }
.fringe { position: absolute; z-index: 7; top: 15%; height: 27%; background: #424269; }
.fringe-left { left: 28%; width: 31%; border-radius: 70% 10% 85% 10%; transform: rotate(-13deg); }
.fringe-right { left: 52%; width: 19%; border-radius: 16% 85% 5% 75%; transform: rotate(16deg); }
.spark { position: absolute; width: 4%; height: 4%; border-radius: 50%; background: #fff; opacity: .7; }
.spark-one { left: 18%; top: 28%; } .spark-two { right: 17%; top: 46%; width: 2%; height: 2%; }
.avatar--speaking .mouth { top: 67%; left: 45%; width: 10%; height: 10%; border: 0; border-radius: 50%; background: #b96f77; animation: speak .48s ease-in-out infinite alternate; }
.avatar--listening .halo { animation: pulse 1.5s ease-in-out infinite; }
.avatar--thinking .brow-right { transform: rotate(-15deg) translateY(-3rpx); }
.avatar--thinking .face { transform: rotate(-3deg); }
@keyframes breathe { 50% { transform: translateY(3rpx); } }
@keyframes blink { 0%, 43%, 47%, 100% { transform: scaleY(1); } 45% { transform: scaleY(.16); } }
@keyframes speak { to { height: 4%; } }
@keyframes pulse { 50% { transform: scale(1.05); opacity: .4; } }
